aws_eks_version                = "REPLACE_WITH_A_CURRENTLY_SUPPORTED_VERSION"
eks_managed_node_groups        = ["default"]
aws_project_tags = {
  Environment = "example"
  Project     = "devops-eks-challenge"
}
